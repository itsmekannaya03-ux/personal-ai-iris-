# ===================================================
# IRIS AIOS - Backend Environment Variables
# Copy this file to backend/.env and replace placeholders
# DO NOT commit backend/.env to version control
# ===================================================

# Neon PostgreSQL Cloud Connection (Production on Render)
# Format: postgresql+asyncpg://<username>:<password>@<neon-hostname>/<database>?ssl=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.c-8.us-east-2.aws.neon.tech/neondb?ssl=require

# Optional Local Synchronous Database (Development migrations / scripts only)
DATABASE_URL_SYNC=postgresql://postgres:postgres@127.0.0.1:5432/iris_db

# Security & Authentication (Generate secure keys with: openssl rand -hex 32)
SECRET_KEY=generate_a_secure_random_64_character_hex_key_here
REFRESH_SECRET_KEY=generate_a_second_secure_random_64_character_hex_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (Comma-separated for frontend integration)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.vercel.app

# Backend Base URL
BASE_URL=http://localhost:8001

# Optional Payment Gateway Integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

