# IRIS Environment Configuration
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/iris

# JWT
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API
API_PORT=8001
ENGINE_PORT=5743
FRONTEND_PORT=3000

# Cloud AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Encryption
ENCRYPTION_KEY=

# IRIS Data Directory
IRIS_DATA_DIR=~/.iris
