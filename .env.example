# ===================================================
# IRIS AIOS - Master Environment Configuration Template
# Copy this file to .env and fill in with your private credentials
# NEVER commit .env to GitHub
# ===================================================

# Neon PostgreSQL Cloud Database (Used by Backend API)
# Format: postgresql+asyncpg://<username>:<password>@<neon-hostname>/<database>?ssl=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.c-8.us-east-2.aws.neon.tech/neondb?ssl=require
DATABASE_URL_SYNC=postgresql://postgres:postgres@127.0.0.1:5432/iris_db

# Security & JWT Tokens (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=generate_a_secure_random_64_character_hex_key_here
REFRESH_SECRET_KEY=generate_a_second_secure_random_64_character_hex_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Network, Ports & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BASE_URL=http://localhost:8001
API_PORT=8001
ENGINE_PORT=5743
FRONTEND_PORT=3000

# Payments (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Local Engine & AI Storage
IRIS_DATA_DIR=~/.iris
